# Reference: <https://postmarketos.org/devicepkg>
maintainer="Oleksii Onchul <oleksiionchul@gmail.com>"
pkgname=device-nothing-froggerpro
pkgdesc="Nothing Phone (4a) Pro"
pkgver=1
pkgrel=15
url="https://postmarketos.org"
license="MIT AND BSD-3-Clause"
arch="aarch64"
options="!check !archcheck"
depends="
	alsa-ucm-conf
	firmware-nothing-froggerpro-adreno
	firmware-nothing-froggerpro-adsp
	firmware-nothing-froggerpro-amplifiers
	firmware-nothing-froggerpro-audio
	firmware-nothing-froggerpro-bluetooth
	firmware-nothing-froggerpro-cdsp
	firmware-nothing-froggerpro-dsp
	firmware-nothing-froggerpro-ipa
	firmware-nothing-froggerpro-modem
	firmware-nothing-froggerpro-sensors
	firmware-nothing-froggerpro-vpu
	firmware-nothing-froggerpro-wpss
	linux-firmware-ath11k
	linux-postmarketos-qcom-eliza
	make-dynpart-mappings
	mkbootimg
	postmarketos-base
	soc-qcom
	soc-qcom-modem
	systemd-boot
"
makedepends="devicepkg-dev"
makedepends_build="alsa-utils"
source="
	81-libssc-nothing-froggerpro.rules
	72-feedbackd-nothing-froggerpro.rules
	hexagonrpcd-adsp-sensorspd.conf
	hexagonrpcd-adsp-sensorspd-systemd.conf
	deviceinfo
	modules-initfs
	froggerpro-tplg.conf
	alsa-ucm-conf/froggerpro.conf
	alsa-ucm-conf/HiFi.conf
"

build() {
	devicepkg_build $startdir $pkgname
	alsatplg -c "$srcdir"/froggerpro-tplg.conf -o "$srcdir"/froggerpro-tplg.bin
}

package() {
	devicepkg_package $startdir $pkgname

	install -Dm644 "$srcdir"/froggerpro-tplg.bin \
		"$pkgdir/usr/lib/firmware/qcom/froggerpro/Nothing Phone (4a) Pro-tplg.bin"

	install -Dm644 "$srcdir"/froggerpro.conf \
		"$pkgdir/usr/share/alsa/ucm2/Qualcomm/froggerpro/froggerpro.conf"
	install -Dm644 "$srcdir"/HiFi.conf \
		"$pkgdir/usr/share/alsa/ucm2/Qualcomm/froggerpro/HiFi.conf"
	mkdir -p "$pkgdir/usr/share/alsa/ucm2/conf.d/froggerpro"
	ln -s ../../Qualcomm/froggerpro/froggerpro.conf \
		"$pkgdir/usr/share/alsa/ucm2/conf.d/froggerpro/froggerpro.conf"

	install -Dm644 "$srcdir"/81-libssc-nothing-froggerpro.rules \
		"$pkgdir"/usr/lib/udev/rules.d/81-libssc-nothing-froggerpro.rules

	install -Dm644 "$srcdir"/72-feedbackd-nothing-froggerpro.rules \
		"$pkgdir"/usr/lib/udev/rules.d/72-feedbackd-nothing-froggerpro.rules

	install -Dm644 "$srcdir"/hexagonrpcd-adsp-sensorspd.conf \
	"$pkgdir"/usr/share/hexagonrpcd/hexagonrpcd-adsp-sensorspd.conf

	install -Dm644 "$srcdir"/hexagonrpcd-adsp-sensorspd-systemd.conf \
	"$pkgdir"/usr/lib/systemd/system/hexagonrpcd-adsp-sensorspd.service.d/10-froggerpro.conf
}

